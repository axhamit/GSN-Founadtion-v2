# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.gsnfoundation.com
# Set to "true" once GSN has approved the proposed AI courses for indexing
INDEX_PROPOSED_COURSES=true
# Your existing Sign In / Sign Up URLs
NEXT_PUBLIC_SIGNIN_URL=/sign-in
NEXT_PUBLIC_SIGNUP_URL=/sign-up
# Where inquiry form submissions are forwarded (Zapier/Make/Slack/your API)
INQUIRY_WEBHOOK_URL=
# Search engine verification tokens (leave empty until you have them)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
